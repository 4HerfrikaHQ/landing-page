{
  "format": "page",
  "id": "campus",
  "label": "Campus",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": "e.g. University of Lagos"
        }
      },
      "university": {
        "type": "Text",
        "config": {
          "label": "University",
          "placeholder": ""
        }
      },
      "country": {
        "type": "Text",
        "config": {
          "label": "Country",
          "placeholder": ""
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Summary",
          "placeholder": "Short blurb shown on the campuses list"
        }
      },
      "cover_image": {
        "type": "Image",
        "config": {
          "label": "Cover Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "lead_ambassador": {
        "type": "Text",
        "config": {
          "label": "Lead Ambassador",
          "placeholder": ""
        }
      },
      "lead_ambassador_role": {
        "type": "Text",
        "config": {
          "label": "Lead Ambassador Role",
          "placeholder": "e.g. Chapter President, Final-year CS"
        }
      },
      "lead_ambassador_photo": {
        "type": "Image",
        "config": {
          "label": "Lead Ambassador Photo",
          "constraint": {},
          "thumbnails": []
        }
      },
      "lead_ambassador_bio": {
        "type": "Text",
        "config": { "label": "Lead Ambassador Bio", "placeholder": "" }
      },
      "lead_ambassador_socials": {
        "type": "Group",
        "config": {
          "label": "Lead Ambassador Socials",
          "repeat": true,
          "fields": {
            "platform": {
              "type": "Select",
              "config": {
                "label": "Platform",
                "options": ["LinkedIn", "X", "Instagram"]
              }
            },
            "url": {
              "type": "Link",
              "config": {
                "label": "URL",
                "select": null,
                "allowTargetBlank": true,
                "allowText": false,
                "repeat": false
              }
            }
          }
        }
      },
      "founded_date": {
        "type": "Date",
        "config": {
          "label": "Founded Date"
        }
      },
      "member_count": {
        "type": "Number",
        "config": {
          "label": "Member Count",
          "placeholder": ""
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "Body",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,heading2,heading3,strong,em,hyperlink,list-item,o-list-item,image,embed"
        }
      },
      "related_projects": {
        "type": "Group",
        "config": {
          "label": "Related Projects",
          "repeat": true,
          "fields": {
            "title": {
              "type": "Text",
              "config": { "label": "Title", "placeholder": "" }
            },
            "summary": {
              "type": "Text",
              "config": { "label": "Summary", "placeholder": "" }
            },
            "slug": {
              "type": "Text",
              "config": {
                "label": "Project Slug",
                "placeholder": "e.g. girls-tech-bootcamp"
              }
            },
            "category": {
              "type": "Text",
              "config": { "label": "Category", "placeholder": "" }
            },
            "cover_image": {
              "type": "Image",
              "config": {
                "label": "Cover Image",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      },
      "testimonials": {
        "type": "Group",
        "config": {
          "label": "Testimonials",
          "repeat": true,
          "fields": {
            "quote": {
              "type": "Text",
              "config": { "label": "Quote", "placeholder": "" }
            },
            "name": {
              "type": "Text",
              "config": { "label": "Name", "placeholder": "" }
            },
            "role": {
              "type": "Text",
              "config": {
                "label": "Role",
                "placeholder": "e.g. Final-year Computer Science"
              }
            },
            "photo": {
              "type": "Image",
              "config": {
                "label": "Photo",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      },
      "events": {
        "type": "Group",
        "config": {
          "label": "Upcoming Events",
          "repeat": true,
          "fields": {
            "date": { "type": "Date", "config": { "label": "Date" } },
            "title": {
              "type": "Text",
              "config": { "label": "Title", "placeholder": "" }
            },
            "location": {
              "type": "Text",
              "config": { "label": "Location", "placeholder": "" }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "select": null,
                "allowTargetBlank": true,
                "allowText": false,
                "repeat": false
              }
            }
          }
        }
      },
      "milestones": {
        "type": "Group",
        "config": {
          "label": "Milestones",
          "repeat": true,
          "fields": {
            "date": { "type": "Date", "config": { "label": "Date" } },
            "title": {
              "type": "Text",
              "config": { "label": "Title", "placeholder": "" }
            },
            "description": {
              "type": "Text",
              "config": { "label": "Description", "placeholder": "" }
            }
          }
        }
      },
      "programs": {
        "type": "Group",
        "config": {
          "label": "Programs",
          "repeat": true,
          "fields": {
            "name": {
              "type": "Text",
              "config": { "label": "Name", "placeholder": "e.g. Tech Academy" }
            },
            "description": {
              "type": "Text",
              "config": { "label": "Description", "placeholder": "" }
            }
          }
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "Gallery",
          "repeat": true,
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Image",
                "constraint": {},
                "thumbnails": []
              }
            },
            "caption": {
              "type": "Text",
              "config": {
                "label": "Caption",
                "placeholder": ""
              }
            }
          }
        }
      }
    }
  }
}
