# Grab token from Team Lead
AUTH_TOKEN=

# Forms
RESEND_API_KEY=
# Full "Name <email>" header used as the From: on outbound mail
RESEND_FROM_HEADER="4HerFrika <bookings@4herfrika.org>"
# Bare email used as the ICS organizer address
RESEND_FROM_EMAIL=bookings@4herfrika.org
GOOGLE_SHEET_WEBHOOK_URL=

# Existing 4HerFrika organizer fallback for new bookings when a mentor Google
# connection is absent or unavailable. Keep events on the configured org calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ORG_CALENDAR_ID=

# For locale translations
GT_API_KEY=
GT_PROJECT_ID=

# Mentor-owned Google Calendar / Meet OAuth (server-only; exact callback URL)
# MENTOR_GOOGLE_TOKEN_ENCRYPTION_KEY must decode to exactly 32 random bytes,
# preferably generated with: openssl rand -base64 32
MENTOR_GOOGLE_OAUTH_CLIENT_ID=
MENTOR_GOOGLE_OAUTH_CLIENT_SECRET=
MENTOR_GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/mentor/google-calendar/callback
MENTOR_GOOGLE_TOKEN_ENCRYPTION_KEY=

# Booking cron auth. Set this same value in Vercel and in Supabase Vault.
# Run the following through a private SQL session, replacing both placeholders:
# select vault.create_secret('https://your-production-domain.example', 'booking_cron_site_url');
# select vault.create_secret('your-cron-secret', 'booking_cron_secret');
CRON_SECRET=

# Online giving (Paystack). Leave both empty to show bank transfer only.
# Server only. Live or test secret key from Paystack Dashboard > Settings > API Keys.
# The same key verifies the webhook signature.
PAYSTACK_SECRET_KEY=
# Public key from the same page. Online giving turns on only when both keys are set.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# In Paystack Dashboard > Settings > API Keys set:
#   Webhook URL:  https://your-domain.example/api/paystack/webhook
#   Callback URL: https://your-domain.example/donate/thank-you

# Prismic permanent access token (server only). Deploy it before switching the
# Prismic API to private, or the homepage, FAQ and blog stop loading.
PRISMIC_ACCESS_TOKEN=

# Prismic write token, only for the local course import script
# (bun course:import). Never deploy it.
PRISMIC_WRITE_TOKEN=
