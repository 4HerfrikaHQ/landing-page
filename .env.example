# Grab token from Team Lead
AUTH_TOKEN=

# Forms
RESEND_API_KEY=
# Full "Name <email>" header used as the From: on outbound mail
RESEND_FROM_HEADER="4HerFrika <bookings@4herfrika.org>"
# Bare email used as the ICS organizer address
RESEND_FROM_EMAIL=bookings@4herfrika.org
GOOGLE_SHEET_WEBHOOK_URL=

# Existing 4HerFrika organizer fallback for new bookings when a mentor Google
# connection is absent or unavailable. Keep events on the configured org calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ORG_CALENDAR_ID=

# For locale translations
GT_API_KEY=
GT_PROJECT_ID=

# Mentor-owned Google Calendar / Meet OAuth (server-only; exact callback URL)
# MENTOR_GOOGLE_TOKEN_ENCRYPTION_KEY must decode to exactly 32 random bytes,
# preferably generated with: openssl rand -base64 32
MENTOR_GOOGLE_OAUTH_CLIENT_ID=
MENTOR_GOOGLE_OAUTH_CLIENT_SECRET=
MENTOR_GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/mentor/google-calendar/callback
MENTOR_GOOGLE_TOKEN_ENCRYPTION_KEY=

# Vercel Cron auth
CRON_SECRET=
